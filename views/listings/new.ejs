<% layout("/layout/boilerplate.ejs") %>
<body>
  <div class="row">
    <div class="col-8 offset-2">
      <br /><br />
      <h3>create your new TRAVELO - Listing</h3>

      <form
        method="POST"
        action="/listings"
        novalidate
        class="needs-validation"
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-label">title</label>
          <input
            name="listing[title]"
            placeholder="Add your title"
            type="text"
            class="form-control"
            required
          />
          <div class="valid-feedback">title looks Good</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">description</label>
          <textarea
            name="listing[description]"
            class="form-control"
            required
          ></textarea>
          <div class="invalid-feedback">please enter a short description</div>
        </div>
        <br />

        <div class="mb-3">
          <label for="image" class="form-label">upload image</label>
          <input
            name="listing[image]"
            type="file"
            accept="image/*"
            class="form-control"
          />
        </div>
        <div class="mb-3">
          <label for="price" class="form-label">price</label>
          <input
            name="listing[price]"
            placeholder="enter price"
            class="form-control"
            required
          />
          <div class="invalid-feedback">enter price</div>
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="location" class="form-label">location</label>
            <input
              name="listing[location]"
              placeholder="enter loaction"
              type="text"
              class="form-control"
              required
            />
            <div class="invalid-feedback">enter a valid loaction</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">country</label>
            <input
              name="listing[country]"
              placeholder="enter country"
              type="text"
              class="form-control"
              required
            />
            <div class="invalid-feedback">enter a valid country name</div>
          </div>
        </div>

        <button class="btn btn-dark add-btn mt-3">Create new travelo</button>
        <br /><br /><br />
      </form>
    </div>
  </div>
</body>
